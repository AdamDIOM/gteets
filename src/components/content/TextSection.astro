---
import ContentRenderer from "../ContentRenderer.astro";
interface Props {
    title: string;
    subtitle: string;
    content: any[];
    colSize?: string;
    props?: {
        colSize?: string;
    };
}

const { title, subtitle, content = [{}], props = {} } = Astro.props;

const gridClasses: Record<string, Record<number, string>> = {
    xs: {
        1: "xs:grid-cols-1",
        2: "xs:grid-cols-2",
        3: "xs:grid-cols-3",
    },
    sm: {
        1: "sm:grid-cols-1",
        2: "sm:grid-cols-2",
        3: "sm:grid-cols-3",
    },
    md: {
        1: "md:grid-cols-1",
        2: "md:grid-cols-2",
        3: "md:grid-cols-3",
    },
    lg: {
        1: "lg:grid-cols-1",
        2: "lg:grid-cols-2",
        3: "lg:grid-cols-3",
    },
    xl: {
        1: "xl:grid-cols-1",
        2: "xl:grid-cols-2",
        3: "xl:grid-cols-3",
    },
};

const gridClass =
    gridClasses[props?.colSize ?? "lg"]?.[((content.length - 1) % 3) + 1] ??
    "grid-cols-1";
---

<section class="bg-primary text-white">
    <div class="mx-auto max-w-7xl items-center gap-12 px-6 py-6">
        <h2 class="text-3xl lg:text-4xl font-bold">
            {title}
        </h2>
        <div>
            <p class="mt-6 text-xl italic">{subtitle}</p>
        </div>

        <div
            class={`mx-auto max-w-7xl grid grid-cols-1 px-6 py-6 items-center gap-12 ${gridClass}`}
        >
            {
                content.map((item) => (
                    <div>{<ContentRenderer content={item} />}</div>
                ))
            }
        </div>
    </div>
</section>
