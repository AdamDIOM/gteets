---
interface Props {
    image: string;
    title: string;
    description: string;
}

const { image, title, description } = Astro.props;
---

<div class="relative h-full w-full">
    <img src={image} alt={title} class="h-100 w-full rounded-xl object-cover" />

    <div class="absolute inset-0 rounded-xl bg-black/40"></div>

    <div class="absolute bottom-8 left-8 text-white">
        <h3 class="font-heading text-2xl">
            {title}
        </h3>

        <p class="mt-2">
            {description}
        </p>
    </div>
</div>
