---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import TextSection from "../components/content/TextSection.astro";
import { about } from "../data/about";
---

<Layout>
    <section
        class="min-h-screen flex items-center bg-primary text-white w-full"
    >
        <div class="max-w-7xl mx-auto px-6">
            <Hero
                title="About GETS"
                subtitle="Learn more about the Global Engineering Training System."
            />

            {
                about.map((section) => (
                    <TextSection
                        title={section.title}
                        subtitle={section.subtitle}
                        content={section.content}
                        {...(section.props && { props: section.props })}
                    />
                ))
            }

            <!-- section introing the concept and birth -->
            <!-- section introing the team – what roles. List qualifications? -->
            <!-- section introing materials (link to the "plans" page) -->
        </div>
    </section>
</Layout>
